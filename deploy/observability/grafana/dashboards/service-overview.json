{
  "uid": "daylik-service-overview",
  "title": "Daylik — Service Overview",
  "tags": [
    "daylik",
    "red"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "daylik-prometheus"
        },
        "query": "label_values(http_server_request_duration_seconds_count, http_route)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "RED",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Request rate",
      "datasource": {
        "type": "prometheus",
        "uid": "daylik-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{http_route=~\"$route\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Error rate (5xx)",
      "datasource": {
        "type": "prometheus",
        "uid": "daylik-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{http_route=~\"$route\", http_response_status_code=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_request_duration_seconds_count{http_route=~\"$route\"}[$__rate_interval])), 0.001)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "p95 latency",
      "datasource": {
        "type": "prometheus",
        "uid": "daylik-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{http_route=~\"$route\"}[$__rate_interval])))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Total requests",
      "datasource": {
        "type": "prometheus",
        "uid": "daylik-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(http_server_request_duration_seconds_count{http_route=~\"$route\"}[$__range]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency percentiles",
      "description": "Exemplars link straight through to the matching trace in Jaeger.",
      "datasource": {
        "type": "prometheus",
        "uid": "daylik-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 5,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "p50",
          "legendFormat": "p50",
          "exemplar": true,
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_seconds_bucket{http_route=~\"$route\"}[$__rate_interval])))"
        },
        {
          "refId": "p95",
          "legendFormat": "p95",
          "exemplar": true,
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{http_route=~\"$route\"}[$__rate_interval])))"
        },
        {
          "refId": "p99",
          "legendFormat": "p99",
          "exemplar": true,
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{http_route=~\"$route\"}[$__rate_interval])))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request rate by route",
      "datasource": {
        "type": "prometheus",
        "uid": "daylik-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{http_request_method}} {{http_route}}",
          "expr": "sum by (http_request_method, http_route) (rate(http_server_request_duration_seconds_count{http_route=~\"$route\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Responses by status code",
      "datasource": {
        "type": "prometheus",
        "uid": "daylik-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{http_response_status_code}}",
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{http_route=~\"$route\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "type": "row",
      "title": "Postgres",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      }
    },
    {
      "type": "timeseries",
      "title": "pgx pool connections",
      "datasource": {
        "type": "prometheus",
        "uid": "daylik-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 5,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "acquired",
          "expr": "pgxpool_acquired_conns"
        },
        {
          "refId": "B",
          "legendFormat": "idle",
          "expr": "pgxpool_idle_conns"
        },
        {
          "refId": "C",
          "legendFormat": "total",
          "expr": "pgxpool_total_conns"
        },
        {
          "refId": "D",
          "legendFormat": "max",
          "expr": "pgxpool_max_conns"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Connection acquire wait",
      "datasource": {
        "type": "prometheus",
        "uid": "daylik-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 5,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "empty-pool waits/s",
          "expr": "rate(pgxpool_empty_acquire_total[$__rate_interval])"
        }
      ]
    },
    {
      "type": "row",
      "title": "Host",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 31
      }
    },
    {
      "type": "stat",
      "title": "CPU busy",
      "datasource": {
        "type": "prometheus",
        "uid": "daylik-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - avg(system_cpu_utilization_ratio{state=\"idle\"})"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Load average (1m)",
      "datasource": {
        "type": "prometheus",
        "uid": "daylik-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "system_cpu_load_average_1m"
        }
      ]
    },
    {
      "type": "stat",
      "title": "CPU cores",
      "datasource": {
        "type": "prometheus",
        "uid": "daylik-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (cpu) (system_cpu_utilization_ratio))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU utilization by state",
      "datasource": {
        "type": "prometheus",
        "uid": "daylik-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 37
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{state}}",
          "expr": "avg by (state) (system_cpu_utilization_ratio{state!=\"idle\"})"
        }
      ],
      "description": "Fraction of total CPU capacity, averaged across cores. Reports the Docker VM, not the macOS host."
    },
    {
      "type": "timeseries",
      "title": "Load average",
      "datasource": {
        "type": "prometheus",
        "uid": "daylik-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 37
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 5,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "1m",
          "legendFormat": "1m",
          "expr": "system_cpu_load_average_1m"
        },
        {
          "refId": "5m",
          "legendFormat": "5m",
          "expr": "system_cpu_load_average_5m"
        },
        {
          "refId": "15m",
          "legendFormat": "15m",
          "expr": "system_cpu_load_average_15m"
        }
      ]
    }
  ]
}
